###> nelmio/cors-bundle ###
# Localhost + private LAN (10/8, 172.16/12, 192.168/16) for phone/tablet testing.
# Production: only the public site origin, never a broad IP pattern.
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1|10(\.\d{1,3}){3}|192\.168(\.\d{1,3}){2}|172\.(1[6-9]|2\d|3[0-1])(\.\d{1,3}){2}|renlo\.local)(:[0-9]+)?$'
###< nelmio/cors-bundle ###

