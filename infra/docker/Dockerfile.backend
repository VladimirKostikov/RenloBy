FROM composer:2 AS vendor
WORKDIR /app
COPY apps/backend/composer.json apps/backend/composer.lock* ./
RUN composer install --no-scripts --prefer-dist --no-interaction

FROM php:8.4-apache-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq-dev libicu-dev libzip-dev \
    && docker-php-ext-install pdo_pgsql intl opcache zip \
    && a2enmod rewrite headers \
    && rm -rf /var/lib/apt/lists/*
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer
WORKDIR /var/www/backend
COPY --from=vendor /app/vendor ./vendor
COPY apps/backend/ .
COPY infra/docker/apache/backend.conf /etc/apache2/sites-available/000-default.conf
COPY infra/docker/php/uploads.ini /usr/local/etc/php/conf.d/uploads.ini
COPY infra/docker/backend-entrypoint.sh /usr/local/bin/backend-entrypoint.sh
RUN chmod +x /usr/local/bin/backend-entrypoint.sh \
    && mkdir -p var/cache var/log \
    && chown -R www-data:www-data var
EXPOSE 80
ENTRYPOINT ["bash", "/usr/local/bin/backend-entrypoint.sh"]
